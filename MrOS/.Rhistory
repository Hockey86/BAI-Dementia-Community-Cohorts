library(survival)
dataset <- 'MrOS'
folder <- sprintf('/data/haoqisun/BAI_dementia_community/%s', dataset)
df <- read.csv(file.path(folder, sprintf('dataset_%s.csv', dataset)))
df$event <- factor(df$event, levels=c('censor', 'dementia', 'death'))
df <- df[df$prevalent_dementia==0,]
data.type <- 'withoutAPOE'
cols <- c('educcollege', 'BMI', 'race_NonWhite', 'sleepmed', 'pascore')
df <- df[complete.cases(df[,c('time2event','event','BAI','age',cols)]),]
df[,'age_group'] <- as.integer(df$age>=70)
print(dim(df))
formula.str1 <- sprintf('Surv(time2event, event) ~ BAI*age_group + %s', paste0(cols, collapse='+'))
formula.str2 <- gsub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1)
formula.str1
formula.str2
gsub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1)
?gsub
sub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1)
'Surv(time2event, event)'%in% formula.str1
'Sur'%in% formula.str1
'S'%in% formula.str1
'u'%in% formula.str1
"u"%in% formula.str1
formula.str1
gsub("e", "E", "Hello Geek")
gsub("e", "E", formula.str1)
gsub("u", "E", formula.str1)
gsub("Su", "E", formula.str1)
gsub('Su', "E", formula.str1)
gsub('Surv', 'Surv', formula.str1)
gsub('Surv(time2event', 'Surv', formula.str1)
sub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1, fixed=T)
formula.str2 <- gsub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1, fixed=T)
fomrula.str2
formula.str2
formula1 <- as.formula(formula.str1)
formula2 <- as.formula(formula.str2)
pdata <- finegray(formula1, data=df, etype='dementia')
model <- coxph(formula2, weight=fgwt, data=pdata)
sm <- summary(model)
print(sm)
print(AIC(model))
res <- c(sm$coefficients['BAI:age_group', c('exp(coef)', 'Pr(>|z|)')],
sm$conf.int['BAI:age_group', c('lower .95', 'upper .95')],
Np=sm$nevent, N=nrows(df))
res <- c(sm$coefficients['BAI:age_group', c('exp(coef)', 'Pr(>|z|)')],
sm$conf.int['BAI:age_group', c('lower .95', 'upper .95')],
Np=sm$nevent, N=nrow(df))
res
print(res)
write.csv(res, file.path(folder, sprintf('age_interaction_results_%s-survival-%s%s.csv', dataset, data.type, stratification)), row.names=F)
write.csv(res, file.path(folder, sprintf('age_interaction_results_%s-survival-%s.csv', dataset, data.type)), row.names=F)
