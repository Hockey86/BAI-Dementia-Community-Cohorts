library(survival)
library(cmprsk)
library(survminer)
library(tdROC)
dataset <- 'MrOS'
folder <- sprintf('/data/haoqisun/BAI_dementia_community/%s', dataset)
df <- read.csv(file.path(folder, sprintf('dataset_%s.csv'))
df <- df[df$prevalent_dementia==0,]
data.type <- 'withoutAPOE'
cols.basic <- c('age', 'educcollege', 'BMI', 'race_NonWhite', 'sleepmed', 'pascore')
df <- df[complete.cases(df[,c('time2event','event','BAI', cols.basic)]),]
cols <- cols.basic
print(dim(df))
head(df)
df <- read.csv(file.path(folder, sprintf('dataset_%s.csv'))
q
df <- read.csv(file.path(folder, sprintf('dataset_%s.csv')))
df$event <- factor(df$event, levels=c('censor', 'dementia', 'death'))
df <- read.csv(file.path(folder, sprintf('dataset_%s.csv', dataset)))
df$event <- factor(df$event, levels=c('censor', 'dementia', 'death'))
df <- df[df$prevalent_dementia==0,]
data.type <- 'withoutAPOE'
cols.basic <- c('age', 'educcollege', 'BMI', 'race_NonWhite', 'sleepmed', 'pascore')
df <- df[complete.cases(df[,c('time2event','event','BAI', cols.basic)]),]
print(dim(df))
cols <- cols.basic
formula.str1 <- sprintf('Surv(time2event, event) ~ %s', paste0(cols, collapse='+'))
formula.str2 <- gsub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1, fixed=T)
formula1 <- as.formula(formula.str1)
formula2 <- as.formula(formula.str2)
pdata <- finegray(formula1, data=df, etype='dementia')
model1 <- coxph(formula2, weight=fgwt, data=pdata)
sm <- summary(model1)
coef <- t(matrix(coefficients(model1)))
coef <- matrix(rep(t(coef),nrow(df)), ncol=ncol(coef), byrow=T)
z <- rowSums(coef*df[,cols])
roc.res <- tdROC.cr(as.numeric(z), df$time2event, as.integer(df$event)-1, 10, method='integral', output='AUC', nboot=10)
youden.idx <- which.max(roc.res$main_res$ROC$sens-(1-roc.res$main_res$ROC$specB))
roc.res1 <- c(AUC=roc.res$main_res$AUC.B.integral,
AUC.lb=roc.res$boot_res$bAUC.B.integral$CIlow,
AUC.ub=roc.res$boot_res$bAUC.B.integral$CIhigh,
sens.youden=roc.res$main_res$ROC$sens[youden.idx],
spec.youden=roc.res$main_res$ROC$specB[youden.idx],
cutoff.youden=roc.res$main_res$ROC$cut.off[youden.idx])
print(roc.res1)
cols <- c('BAI', cols.basic)
formula.str1 <- sprintf('Surv(time2event, event) ~ %s', paste0(cols, collapse='+'))
formula.str2 <- gsub('Surv(time2event, event)', 'Surv(fgstart, fgstop, fgstatus)', formula.str1, fixed=T)
formula1 <- as.formula(formula.str1)
formula2 <- as.formula(formula.str2)
pdata <- finegray(formula1, data=df, etype='dementia')
model2 <- coxph(formula2, weight=fgwt, data=pdata)
sm <- summary(model2)
coef <- t(matrix(coefficients(model2)))
coef <- matrix(rep(t(coef),nrow(df)), ncol=ncol(coef), byrow=T)
z <- rowSums(coef*df[,cols])
roc.res <- tdROC.cr(as.numeric(z), df$time2event, as.integer(df$event)-1, 10, method='integral', output='AUC', nboot=10)
youden.idx <- which.max(roc.res$main_res$ROC$sens-(1-roc.res$main_res$ROC$specB))
roc.res2 <- c(AUC=roc.res$main_res$AUC.B.integral,
AUC.lb=roc.res$boot_res$bAUC.B.integral$CIlow,
AUC.ub=roc.res$boot_res$bAUC.B.integral$CIhigh,
sens.youden=roc.res$main_res$ROC$sens[youden.idx],
spec.youden=roc.res$main_res$ROC$specB[youden.idx],
cutoff.youden=roc.res$main_res$ROC$cut.off[youden.idx])
roc.res2 <- t(as.data.frame(roc.res2))
print(roc.res2)
plot_tdROC_cr(roc.res1, main=NULL, xlim=c(0,1), ylim=c(0,1))
plot_tdROC_cr(roc.res, main=NULL, xlim=c(0,1), ylim=c(0,1))
rbind(roc.res1, roc.res2)
rbind(withoutBAI=roc.res1, withBAI=roc.res2)
perf<-rbind(withoutBAI=roc.res1, withBAI=roc.res2)
write.csv(perf, file=file.path(folder, sprintf("ROC_operation_point_%s.csv", dataset)), row.names=T)
